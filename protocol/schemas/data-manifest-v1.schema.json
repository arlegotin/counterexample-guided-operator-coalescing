{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgoc.local/schema/data-manifest-v1",
  "title": "data-manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "records",
    "roles",
    "membership",
    "salt",
    "exposure_path",
    "lineage_sha256",
    "quarantine"
  ],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "source",
          "revision",
          "shard",
          "row",
          "text",
          "text_path",
          "text_sha256",
          "url",
          "article_id",
          "source_record_id",
          "row_group",
          "local_source_sha256",
          "token_path",
          "token_sha256",
          "metadata"
        ],
        "properties": {
          "document_id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "shard": {
            "type": "string"
          },
          "row": {
            "type": "integer"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "text_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "text_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "article_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_record_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "row_group": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "local_source_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "token_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "token_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "salt": {
      "type": "string"
    },
    "exposure_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "lineage_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "quarantine": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
